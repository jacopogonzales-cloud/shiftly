# Copy to .env.local and fill in. Never commit .env.local.

# Postgres connection string (Render: External Database URL locally, Internal Database URL on Render).
DATABASE_URL=

# PayPal REST app, Sandbox credentials (developer.paypal.com → Apps & Credentials → Sandbox).
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
# Webhook id from the PayPal developer dashboard. Optional locally; reconcile works without it.
PAYPAL_WEBHOOK_ID=

# OpenAI API key and comma-separated model ids (first = preferred, the rest are fallbacks).
OPENAI_API_KEY=
OPENAI_MODELS=

# Random secret: header x-cron-secret for POST /api/paypal/reconcile, and the key that signs invitation links.
SHIFTLY_CRON_SECRET=

# Seed only: 3 comma-separated PayPal Sandbox Personal account emails (they receive real sandbox payouts).
SHIFTLY_PAYOUT_RECIPIENTS=
